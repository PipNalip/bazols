# Public example only. Never put real keys or passwords in this file.
NODE_ENV=development
PORT=8000

# Local PostgreSQL. Replace passwords before using this file outside local development.
POSTGRES_DB=bazols
POSTGRES_USER=bazols
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bazols:replace-with-a-local-database-password@127.0.0.1:5432/bazols

# Application secrets. Generate private values in .env; never commit them.
SESSION_SECRET=replace-with-a-random-session-secret
RAW_DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Exact browser origin accepted for login and all state-changing requests.
APP_ORIGIN=http://127.0.0.1:5173

# Source system credentials. Keep real values only in the ignored .env file.
SOURCE_SITE_URL=https://example.invalid
SOURCE_SITE_LOGIN=replace-with-a-fake-login
SOURCE_SITE_PASSWORD=replace-with-a-fake-password
